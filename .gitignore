# Raw yt-dlp metadata (hundreds of MB); distilled into <channel>/analysis/dataset.json
*/analysis/meta/**/*.info.json
*/analysis/clips/
# Scratch files from the fetch runs
*/analysis/batch_*
*/analysis/todo.txt
*/analysis/*_err.txt
*/analysis/meta_errors.txt

# Studio: never commit API keys; keep generated runs out of git (large media)
.env
**/.env
studio/runs/
studio/test/
studio/reference/
studio/spend.jsonl

# Rendered episode videos (large)
episodes/*/render/

# Wil's voice reference and narration takes (private)
studio/voice/

# Python caches
__pycache__/
