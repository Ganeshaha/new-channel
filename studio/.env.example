# Copy this file to .env (same folder) and paste your key. .env is gitignored, so never commit your key.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local early-warning cap per run folder (USD). Also set a hard credit limit on the key in the OpenRouter dashboard.
BUDGET_USD=10

# Optional model overrides
IMAGE_MODEL=google/gemini-3.1-flash-image
SPEECH_MODEL=openai/gpt-audio-mini
